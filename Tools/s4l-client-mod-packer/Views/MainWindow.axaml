<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S4LClientModPacker.Views.MainWindow"
        Width="1080" Height="680" MinWidth="820" MinHeight="500"
        Title="S4 League Client Mod Packer">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8" RowSpacing="8">

        <!-- Source -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Spacing="4">
                <TextBlock Text="Source archive (the client whose edits you want to share)"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="SourcePath" IsReadOnly="True"/>
                    <Button x:Name="BrowseSource" Content="Browse…" Click="BrowseSource_Click"/>
                </Grid>
            </StackPanel>
            <Button x:Name="LoadSource" Grid.Column="1" Content="Load entries" Click="LoadSource_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Entry selection -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Select entries to bundle (Ctrl+click multi-select)"/>
        </StackPanel>
        <ListBox x:Name="EntryList" Grid.Row="2" SelectionMode="Multiple" Margin="0,4,0,0"/>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="BuildMod" Content="Build mod package…" Click="BuildMod_Click"/>
            <Button x:Name="InstallMod" Content="Install into client…" Click="InstallMod_Click"/>
            <Button x:Name="LoadMod" Content="Open existing .s4mod…" Click="LoadMod_Click"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="#8a8" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Install target (for Install) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
            <StackPanel Spacing="4">
                <TextBlock Text="Install target archive (destination client resource.s4hd)"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="TargetPath" IsReadOnly="True"/>
                    <Button x:Name="BrowseTarget" Grid.Column="1" Content="Browse…" Click="BrowseTarget_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
