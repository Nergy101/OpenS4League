<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S4LLocalisationEditor.Views.MainWindow"
        Width="1100" Height="680" MinWidth="820" MinHeight="520"
        Title="S4 League Localisation Editor">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8" RowSpacing="8">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Spacing="4">
                <TextBlock Text="Open resource.s4hd (language/*.x7 files are decoded for editing)"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="ArchivePath" IsReadOnly="True"/>
                    <Button x:Name="BrowseArchive" Content="Browse…" Click="BrowseArchive_Click"/>
                </Grid>
            </StackPanel>
            <Button x:Name="OpenArchive" Grid.Column="1" Content="Open" Click="OpenArchive_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Locale files -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0" ColumnSpacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Locale files (click to edit)"/>
                <ComboBox x:Name="LocaleCombo" SelectionChanged="LocaleCombo_SelectionChanged"/>
            </StackPanel>
            <Button x:Name="Diff" Grid.Column="1" Content="Missing-key report…" Click="Diff_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Editor -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock x:Name="LocaleInfo" VerticalAlignment="Center" Foreground="#9aa"/>
                <Button x:Name="Save" Grid.Column="1" Content="Save entry" Click="Save_Click"/>
            </Grid>
            <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" FontFamily="Consolas" FontSize="13"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="FindMissing" Content="Copy missing keys to this file" Click="FindMissing_Click"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="#8a8" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
