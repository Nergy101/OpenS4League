<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="using:S4League.View"
        x:Class="S4LAnimationCreator.Views.MainWindow"
        Width="1200" Height="720" MinWidth="900" MinHeight="560"
        Title="S4 League Animation Creator">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,*" Margin="8" RowSpacing="8" ColumnSpacing="10">

        <!-- Toolbar -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
            <Button x:Name="OpenScn" Content="Open .scn..." Click="OpenScn_Click"/>
            <Button x:Name="OpenArchive" Content="Open resource.s4hd..." Click="OpenArchive_Click"/>
            <Button x:Name="SaveAs" Content="Save As..." Click="SaveAs_Click"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="#8a8" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Left: model/animation selection + timeline editor -->
        <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Text="Models with animations" FontWeight="Bold"/>
            <ComboBox x:Name="ModelCombo" SelectionChanged="ModelCombo_SelectionChanged"/>
            <TextBlock Text="Animations" FontWeight="Bold"/>
            <ComboBox x:Name="AnimCombo" SelectionChanged="AnimCombo_SelectionChanged"/>

            <Separator/>

            <TextBlock Text="Duration (s)" FontWeight="Bold"/>
            <TextBox x:Name="DurationBox" TextChanged="DurationBox_TextChanged"/>

            <TextBlock Text="Keyframes (translation)" FontWeight="Bold"/>
            <ListBox x:Name="KeyList" Height="170" SelectionChanged="KeyList_SelectionChanged"/>
            <TextBlock Text="Selected key" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="4">
                <TextBox x:Name="KeyX"/>
                <TextBox x:Name="KeyY" Grid.Column="1"/>
                <TextBox x:Name="KeyZ" Grid.Column="2"/>
                <Button x:Name="ApplyKey" Grid.Column="3" Content="Apply" Click="ApplyKey_Click"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddKey" Content="+ Key" Click="AddKey_Click"/>
                <Button x:Name="DelKey" Content="Remove key" Click="DelKey_Click"/>
                <Button x:Name="ClearKeys" Content="Clear keys" Click="ClearKeys_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Right: 3D preview + playback -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">
            <view:ScnPreviewView x:Name="Preview"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="PlayBtn" Content="Play" Click="Play_Click"/>
                <Button x:Name="StopBtn" Content="Stop" Click="Stop_Click"/>
                <TextBlock Text="Time:" VerticalAlignment="Center"/>
                <Slider x:Name="TimeSlider" MinWidth="200" VerticalAlignment="Center"
                        ValueChanged="TimeSlider_ValueChanged"/>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" MinWidth="140" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
