<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:S4LClientConfigurator.ViewModels"
        x:Class="S4LClientConfigurator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1060" Height="600" MinWidth="760" MinHeight="440"
        Title="S4 League Client Configurator">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="10,8" Background="#20FFFFFF">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="Open resource.s4hd…" Command="{Binding OpenCommand}" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0"/>
        <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" MinWidth="90"/>
      </Grid>
    </Border>

    <!-- Screens grid -->
    <DataGrid Grid.Row="1" ItemsSource="{Binding Screens}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="False"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              x:CompileBindings="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Screen" Binding="{Binding DisplayName}" Width="1.6*"/>
        <DataGridTemplateColumn Header="Resource path" Width="2.6*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding ResourcePath, Mode=TwoWay}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseArchiveCommand}" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Preview" Width="2.0*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                <Image Source="{Binding Thumbnail}" MaxHeight="64" MaxWidth="110" Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontSize="12" Foreground="#99FFFFFF"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Actions" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Set from file…" Command="{Binding SetFromFileCommand}" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="10,6" Background="#20FFFFFF">
      <TextBlock Text="{Binding ClientPath}" Foreground="#99FFFFFF"/>
    </Border>
  </Grid>
</Window>
