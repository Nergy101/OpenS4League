{
  Network:
  {
    Listener: 0.0.0.0:28003
    WorkerThreads: -1
    MaxSessions: 100
  }
  ServerList:
  {
    Id: 1
    Name: OpenS4L-Chat
    Address: 127.0.0.1
    UpdateInterval: 30000
  }
  Metrics:
  {
    Listener: http://0.0.0.0:28006/
  }
  Database:
  {
    ConnectionStrings:
    {
      Redis: redis
      Auth: Host=postgres;Port=5432;Database=auth;Username=postgres;Password=1234;
      Game: Host=postgres;Port=5432;Database=game;Username=postgres;Password=1234;
    }
    RunMigration: true
  }
  Logging:
  {
    Name: chat
    Directory: logs
    Level: Debug
  }
}
