{
  Listener: 127.0.0.1:28002
  WorkerThreads: -1
  ServerlistTimeout: 60000
  Database:
  {
    ConnectionStrings:
    {
      Redis: localhost
      Auth: Host=localhost;Port=5432;Database=auth;Username=postgres;Password=1234;
    }
    RunMigration: true
  }
  Logging:
  {
    Name: auth
    Directory: logs
    Level: Debug
  }
  DataDir: ../data
}
