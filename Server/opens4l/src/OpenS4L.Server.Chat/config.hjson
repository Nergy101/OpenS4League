{
  Network:
  {
    Listener: 127.0.0.1:28003
    WorkerThreads: -1
    MaxSessions: 100
  }
  ServerList:
  {
    Id: 1
    Name: OpenS4L-Chat
    Address: 127.0.0.1
    UpdateInterval: 30000
  }
  Database:
  {
    ConnectionStrings:
    {
      Redis: localhost
      Auth: Host=localhost;Port=5432;Database=auth;Username=postgres;Password=1234;
      Game: Host=localhost;Port=5432;Database=game;Username=postgres;Password=1234;
    }
    RunMigration: true
  }
  Logging:
  {
    Name: chat
    Directory: logs
    Level: Debug
  }
}
